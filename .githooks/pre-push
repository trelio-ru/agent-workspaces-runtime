#!/usr/bin/env bash
set -euo pipefail
source_sha=""
release_tag=""
protected=0
while read -r local_ref local_oid remote_ref remote_oid; do
  if [[ "${remote_ref}" == "refs/heads/main" ]]; then
    protected=1
    source_sha="${local_oid}"
  elif [[ "${remote_ref}" =~ ^refs/tags/(v[0-9]+\.[0-9]+\.[0-9]+|codex-hooks-source-v[0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
    if [[ -n "${release_tag}" ]]; then echo 'One release tag per queued operation is required' >&2; exit 1; fi
    protected=1
    release_tag="${BASH_REMATCH[1]}"
    # Annotated tags carry a tag-object OID in stdin, not the source commit.
    tag_sha="$(git rev-parse --verify "${local_oid}^{commit}")"
    if [[ -n "${source_sha}" && "${source_sha}" != "${tag_sha}" ]]; then exit 1; fi
    source_sha="${tag_sha}"
  fi
done
if [[ "${protected}" == 1 ]]; then
  hook_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
  node "${hook_directory}/../scripts/assert-coordination.mjs" "${source_sha}" "${release_tag}"
fi
